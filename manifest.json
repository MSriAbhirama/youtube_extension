{
  "manifest_version": 3,
  "name": "YouTube Cleaner",
  "version": "1.1",
  "description": "Control auto-playlists on YouTube",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ]
}